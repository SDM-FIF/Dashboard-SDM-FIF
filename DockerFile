FROM php:8.2-cli

# Install system dependencies + GD dependency
RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    zip \
    nodejs \
    npm \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev

# 🔥 INSTALL GD DENGAN BENAR
RUN docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg \
    && docker-php-ext-install gd

# install extension lain
RUN docker-php-ext-install pdo_mysql mbstring exif pcntl bcmath zip

# install composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# copy project
COPY . .

# 🔥 CHECK GD TERINSTALL (debug penting)
RUN php -m | grep gd

# composer install (normal, no ignore)
RUN composer install --no-dev --optimize-autoloader --no-interaction

# build FE
RUN npm install
RUN npm run build

# permission
RUN chmod -R 775 storage bootstrap/cache || true

EXPOSE 8080

CMD php artisan serve --host=0.0.0.0 --port=${PORT}
